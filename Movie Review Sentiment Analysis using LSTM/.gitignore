# ── Python ────────────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.pyo
*.pyd

# ── Virtual environments ───────────────────────────────────────────────────────
.venv/
venv/
env/
ENV/
.env

# ── Distribution / packaging ───────────────────────────────────────────────────
dist/
build/
*.egg-info/
*.egg
.eggs/

# ── Jupyter / IPython ─────────────────────────────────────────────────────────
.ipynb_checkpoints/
*.ipynb

# ── Testing & coverage ────────────────────────────────────────────────────────
.pytest_cache/
.coverage
htmlcov/
.tox/

# ── Type checkers ─────────────────────────────────────────────────────────────
.mypy_cache/
.pytype/

# ── IDEs & editors ────────────────────────────────────────────────────────────
.vscode/
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
*.sublime-project
*.sublime-workspace

# ── OS-generated files ────────────────────────────────────────────────────────
.DS_Store
Thumbs.db
desktop.ini

# ── Keras / TensorFlow artefacts ──────────────────────────────────────────────
*.h5
*.keras
*.pb
saved_model/
checkpoints/
logs/

# ── Dataset cache (downloaded by Keras automatically) ─────────────────────────
~/.keras/datasets/
*.npz

# ── Misc ──────────────────────────────────────────────────────────────────────
*.log
*.tmp
*.bak
